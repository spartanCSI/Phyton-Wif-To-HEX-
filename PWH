if __name__ == "__main__":
    print("🔐 Konversi WIF ke Private Key (Hex)")
    print("-----------------------------------")
    
    while True:
        wif = input("\nMasukkan WIF (ketik 'exit' untuk keluar): ").strip()
        
        if wif.lower() in ('exit', 'quit', 'q'):
            print("👋 Terima kasih! Program selesai.")
            break
            
        if not wif:
            print("⚠️  WIF tidak boleh kosong.")
            continue
            
        try:
            private_hex, is_compressed = wif_to_hex(wif)
            print("\n✅ BERHASIL!")
            print("Private Key (hex):", private_hex)
            print("Compressed       :", is_compressed)
        except Exception as e:
            print("\n" + str(e))
